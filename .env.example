# Copy to .env and fill in your local credentials.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
# Reach Jev through OpenRouter instead of TypeSafe directly:
# use config/jev_mem_openrouter.json, which reads this key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint:
# OPENAI_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
